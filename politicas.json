{
  "versao": "1.0",
  "efeito_padrao": "negar",
  "acoes_proibidas": ["reboot_all", "disable_auth", "delete_data", "open_firewall", "shutdown_cloud"],
  "agentes": {
    "iot_device": {
      "acoes_permitidas": ["notificar_operador"],
      "escopo": ["dev*"]
    },
    "edge_agent": {
      "acoes_permitidas": ["throttle_workload", "clear_cache", "reroute_link", "reset_sensor",
                           "restart_service", "restart_device", "notificar_operador"],
      "escopo": ["dev*", "edge*"]
    },
    "cloud_coordinator": {
      "acoes_permitidas": ["throttle_workload", "clear_cache", "reroute_link", "reset_sensor",
                           "restart_service", "restart_device", "notificar_operador"],
      "escopo": ["*"]
    }
  },
  "acoes_condicionais": {
    "restart_device": {"exige_humano": true}
  },
  "integridade": {
    "exigir_evidencia": true,
    "validade_s": 30,
    "tolerancia_valor": 0.2,
    "confianca_minima": 0.6
  },
  "limites": {"max_acoes_por_alvo": 2, "janela_s": 60}
}
